{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*" : ["./src/*"]
        },
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        
        /* Linting */
        "strict": true
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}